<?xml version="1.0" encoding="UTF-8"?>
<PluginList>
	<Plugin id="CyclePeakLookahead_SE" name="CyclePeakLookahead" category="RwS Modules">
		<Description>Cycle peak detection with CV output (0–10 V compressor-style)</Description>

		<Audio>
			<!-- Audio pins -->
			<Pin name="Input" datatype="float" direction="in" rate="audio"/>
			<Pin name="Output" datatype="float" direction="out" rate="audio"/>
			<Pin name="CV" datatype="float" direction="out" rate="audio"/>

			<!-- Control pins -->
			<Pin name="Threshold" datatype="float" direction="in" rate="control" default="3.0"/>
			<Pin name="Ratio" datatype="float" direction="in" rate="control" default="1.0"/>
			<Pin name="Attack" datatype="float" direction="in" rate="control" default="0.1"/>
			<Pin name="Release" datatype="float" direction="in" rate="control" default="50.0"/>
			<Pin name="MaxFreq" datatype="float" direction="in" rate="control" default="4000.0"/>
		</Audio>

		<Vendor>Road_within_Spacetime</Vendor>
	</Plugin>
</PluginList>
