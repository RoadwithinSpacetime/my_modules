<?xml version="1.0" encoding="UTF-8"?>
<PluginList>
	<Plugin id="CyclePeakLookahead" name="CyclePeakLookahead" category="Modifiers">
		<Audio>
			<!-- Mono audio input -->
			<Pin name="Input" datatype="float" rate="audio" direction="in"/>
			<!-- Mono audio output -->
			<Pin name="Output" datatype="float" rate="audio" direction="out"/>
		</Audio>
		<Control>
			<!-- Lookahead in milliseconds, default 10ms -->
			<FloatInPin name="LookaheadMs" default="10.0"/>
			<!-- Hysteresis for peak decay, default 0.01 -->
			<FloatInPin name="Hysteresis" default="0.01"/>
			<!-- Absolute mode: 0 = off, 1 = on, default 1 -->
			<IntInPin name="AbsMode" default="1"/>
			<!-- Peak output -->
			<FloatOutPin name="Peak"/>
		</Control>
	</Plugin>
</PluginList>
