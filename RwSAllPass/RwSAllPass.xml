<?xml version="1.0" encoding="UTF-8"?>
<PluginList>
	<Plugin id="RwSAllPass" name="RwSAllPass" category="RwS Modules">
		<Description>
			Dynamic analog-style phase conditioner.
			Mono DSP module; SynthEdit handles stereo automatically.
		</Description>

		<Audio>
			<Pin name="Input"  datatype="float" direction="in"  rate="audio"/>
			<Pin name="Output" datatype="float" direction="out" rate="audio"/>

			<Pin name="Depth" datatype="float" direction="in" rate="control" default="0.5"/>
		</Audio>

		<Vendor>Road_within_Spacetime</Vendor>
	</Plugin>
</PluginList>
