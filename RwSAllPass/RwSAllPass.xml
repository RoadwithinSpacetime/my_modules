<?xml version="1.0" encoding="UTF-8"?>
<PluginList>
	<Plugin id="RwSAllPass" name="RwSAllPass" category="RwS Modules">
		<Description>
			Dynamic analog-style phase conditioner.
			Internal level-dependent phase motion for depth preconditioning.
		</Description>

		<Audio>
			<Pin name="In L"  datatype="float" direction="in"  rate="audio"/>
			<Pin name="In R"  datatype="float" direction="in"  rate="audio"/>
			<Pin name="Out L" datatype="float" direction="out" rate="audio"/>
			<Pin name="Out R" datatype="float" direction="out" rate="audio"/>

			<Pin name="Depth" datatype="float" direction="in" rate="control" default="0.5"/>
		</Audio>

		<Vendor>Road_within_Spacetime</Vendor>
	</Plugin>
</PluginList>
