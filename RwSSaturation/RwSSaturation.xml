<?xml version="1.0" encoding="utf-8"?>
<Plugin id="RwSSaturation" name="RwS Saturation" category="RwS Modules">
	<Audio>
		<Pin name="In" direction="in" datatype="float" rate="audio"/>
		<Pin name="Out" direction="out" datatype="float" rate="audio"/>
	</Audio>

	<Parameters>
		<Pin name="Drive" datatype="float" default="1.0" min="0.0" max="10.0" smoothing="false"/>
		<Pin name="Mix" datatype="float" default="1.0" min="0.0" max="1.0" smoothing="false"/>
		<Pin name="Alpha" datatype="float" default="0.5" min="0.0" max="1.0" smoothing="false"/>
		<Pin name="Beta" datatype="float" default="0.25" min="0.0" max="1.0" smoothing="false"/>
		<Pin name="Hyst" datatype="float" default="0.1" min="0.0" max="1.0" smoothing="false"/>
		<Pin name="HystFreq" datatype="float" default="15000.0" min="1000.0" max="20000.0" units="Hz" smoothing="false"/>
	</Parameters>
</Plugin>
